# ==============================================================================
# WhatsappEntrega - Arquivo de Configuracao de Exemplo (.env.example)
# Sistema monolitico modular de automacao Direct Response no WhatsApp com Baileys, SQLite e Cakto
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Servidor HTTP & Ambiente de Execucao (PORT_GUARD 4000-4999)
# ------------------------------------------------------------------------------
# Porta de escuta do servidor HTTP (Obrigatorio na faixa 4000-4999 para PORT_GUARD)
PORT=4100

# Endereco IP ou Host para binding da aplicacao (padrao 0.0.0.0 para aceitar conexoes de proxy reverso)
HOST=0.0.0.0

# Ambiente de execucao: development | production | test
NODE_ENV=development

# Nivel de detalhamento dos logs: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Integracao Cakto & Seguranca Webhook (HMAC-SHA256)
# ------------------------------------------------------------------------------
# Token secreto compartilhado ou chave para validacao HMAC das requisicoes de Webhook da Cakto
# Em producao, preencha com o secret configurado no painel da Cakto
CAKTO_WEBHOOK_SECRET=cakto_webhook_secret_dev
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Motor WhatsApp Baileys (Conexao & Pareamento)
# ------------------------------------------------------------------------------
# Numero de telefone da instancia do WhatsApp para geracao do Pairing Code de 8 digitos
# Formato: DDI + DDD + Numero sem pontuacao (Ex: 5511999998888)
WHATSAPP_PAIRING_PHONE=5511999999999

# ------------------------------------------------------------------------------
# 4. Diretorios de Armazenamento Local e Persistencia SQLite (Modo WAL)
# ------------------------------------------------------------------------------
# Diretorio base para persistencia de arquivos locais
DATA_DIR=./data

# Subdiretorio das chaves e sessoes criptograficas do Baileys (useMultiFileAuthState)
AUTH_INFO_DIR=./data/auth_info

# Subdiretorio do banco de dados relacional SQLite
DATABASE_DIR=./data/database

# Caminho completo do arquivo de banco de dados SQLite (.db) operando em modo WAL
DATABASE_FILE=./data/database/funnel.db

# Subdiretorio de midias (PDFs de entrega imediata e audios PTT Opus em .ogg)
MEDIA_DIR=./data/media
